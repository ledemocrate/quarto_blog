        "---\n",
        "title: \"De la récupération des données de PDF au calcul de l'inflation - Partie Shiny\"\n",
        "format: html\n",
        "categories: ['R', 'Shiny', 'Inflation']\n",
        "author:\n",
        "  name: GOLLENTZ Quentin\n",
        "#  url: https://www.linkedin.com/in/quentin-gollentz-697993172/\n",
        "  email: quentin.gollentz@outlook.com\n",
        "date: last-modified\n",
        "date-format: \"DD-MM-YYYY\"\n",
        "description: \"Récupération de données issus de PDF\"\n",
        "title-block-banner: \"#ECF4FA\"\n",
        "filters:\n",
        "  - shinylive\n",
        "shinylive:\n",
        "  files:\n",
        "    - data/articles.csv\n",
        "---\n",
        "\n",
        "## Création d'un dashboard de réprésentation de l'inflation \n",
        "\n",
        "```{shinylive-r}\n",
        "#| standalone: true\n",
        "#| viewerHeight: 600\n",
        "\n",
        "\n",
        "library(bslib)\n",
        "library(shiny)\n",
        "library(readr)\n",
        "library(utils)\n",
        "library(dplyr)\n",
        "library(stringr)\n",
        "library(tidyr)\n",
        "library(jsonlite)\n",
        "library(maps)\n",
        "library(ggplot2)\n",
        "if (FALSE) {\n",
        "  library(munsell)\n",
        "}\n",
        "\n",
        "articles <- read.csv(\"https://raw.githubusercontent.com/ledemocrate/quarto_blog/refs/heads/main/posts/inflation_calcul/data/articles.csv\")\n",
        "\n",
        "# Conversion de la date\n",
        "articles$date <- as.Date(substr(articles$code_ticket, 1, 8), format = \"%Y%m%d\")\n",
        "\n",
        "ui <- fluidPage(\n",
        "  titlePanel(\"Évolution du prix des articles\"),\n",
        "  \n",
        "  sidebarLayout(\n",
        "    sidebarPanel(\n",
        "      selectInput(\n",
        "        \"article\",\n",
        "        \"Choisir un article :\",\n",
        "        choices = sort(unique(articles$nom))\n",
        "      )\n",
        "    ),\n",
        "    \n",
        "    mainPanel(\n",
        "      plotOutput(\"plot_prix\")\n",
        "    )\n",
        "  )\n",
        ")\n",
        "\n",
        "server <- function(input, output, session) {\n",
        "  \n",
        "  data_filtre <- reactive({\n",
        "    articles %>% filter(nom == input$article)\n",
        "  })\n",
        "  \n",
        "  output$plot_prix <- renderPlot({\n",
        "    ggplot(data_filtre(), aes(x = date, y = prix_unitaire)) +\n",
        "      geom_line(color = \"blue\") +\n",
        "      geom_point(size = 3) +\n",
        "      labs(\n",
        "        title = paste(\"Prix unitaire de :\", input$article),\n",
        "        x = \"Date\",\n",
        "        y = \"Prix (€)\"\n",
        "      ) +\n",
        "      theme_minimal()\n",
        "  })\n",
        "}\n",
        "\n",
        "shinyApp(ui, server)\n",
        "```\n"
      ],
