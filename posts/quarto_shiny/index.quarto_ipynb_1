        "---\n",
        "title: \"De l'intégration d'une application Rshiny dans un document Quarto\"\n",
        "categories: ['R','RShiny', 'Quarto', 'VISA']\n",
        "author:\n",
        "  name: GOLLENTZ Quentin\n",
        "#  url: https://www.linkedin.com/in/quentin-gollentz-697993172/\n",
        "  email: quentin.gollentz@outlook.comm\n",
        "date: last-modified\n",
        "date-format: \"DD-MM-YYYY\"\n",
        "description: \"Traitement des données du 30-12-2025 : Données des VISA\"\n",
        "title-block-banner: \"#ECF4FA\"\n",
        "filters:\n",
        "  - shinylive\n",
